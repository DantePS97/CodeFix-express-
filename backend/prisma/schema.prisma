// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Rol {
  ADMIN
  VENDEDOR
  CONTADOR
}

model Negocio {
  id               Int      @id @default(autoincrement())
  nombre           String   @db.VarChar(150)
  nit              String   @unique @db.VarChar(30)
  tarifaIvaDefault Decimal  @default(19.00) @db.Decimal(5, 2)
  creadoEn         DateTime @default(now())

  usuarios    Usuario[]
  categorias  CategoriaProducto[]
  productos   Producto[]
  movimientos MovimientoInventario[]
  clientes    Cliente[]
  facturas    Factura[]
}

model Usuario {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  nombre         String   @db.VarChar(120)
  correo         String   @unique @db.VarChar(150)
  contraseñaHash String   @db.VarChar(255)
  rol            Rol
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now())

  negocio  Negocio   @relation(fields: [tenantId], references: [id])
  facturas Factura[]

  @@index([tenantId])
}

/// =============================
/// ENUMS
/// =============================

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

/// =============================
/// CATEGORÍAS DE PRODUCTOS
/// =============================

model CategoriaProducto {
  id          Int        @id @default(autoincrement())
  tenantId    Int
  nombre      String     @db.VarChar(100)
  descripcion String?    @db.VarChar(255)
  activa      Boolean    @default(true)

  negocio     Negocio    @relation(fields: [tenantId], references: [id])
  productos   Producto[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([tenantId, nombre])
  @@index([tenantId])
  @@map("categorias_productos")
}

/// =============================
/// PRODUCTOS
/// =============================

model Producto {
  id              Int                  @id @default(autoincrement())
  tenantId        Int
  nombre          String               @db.VarChar(150)
  descripcion     String?              @db.Text
  codigo          String               @db.VarChar(50)
  precio          Decimal              @db.Decimal(10, 2)
  stock           Int                  @default(0)
  stockMinimo     Int                  @default(5)
  activo          Boolean              @default(true)

  categoriaId     Int
  categoria       CategoriaProducto    @relation(fields: [categoriaId], references: [id])
  negocio         Negocio              @relation(fields: [tenantId], references: [id])

  movimientos     MovimientoInventario[]
  detallesFactura DetalleFactura[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([categoriaId])
  @@map("productos")
}

/// =============================
/// MOVIMIENTOS DE INVENTARIO
/// =============================

model MovimientoInventario {
  id              Int              @id @default(autoincrement())
  tenantId        Int

  productoId      Int
  producto        Producto         @relation(fields: [productoId], references: [id])
  negocio         Negocio          @relation(fields: [tenantId], references: [id])

  tipo            TipoMovimiento

  cantidad        Int
  stockAnterior   Int
  stockNuevo      Int

  motivo          String?          @db.VarChar(255)
  observaciones   String?          @db.Text

  referenciaFacturaId Int?
  factura             Factura?     @relation(fields: [referenciaFacturaId], references: [id])

  fechaMovimiento DateTime         @default(now())

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([productoId])
  @@index([fechaMovimiento])
  @@index([referenciaFacturaId])
  @@map("movimientos_inventario")
}

/// =============================
/// CLIENTES
/// =============================

model Cliente {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  nombre         String    @db.VarChar(150)
  identificacion String?   @db.VarChar(30)
  contacto       String?   @db.VarChar(120)
  activo         Boolean   @default(true)

  negocio        Negocio   @relation(fields: [tenantId], references: [id])
  facturas       Factura[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@map("clientes")
}

/// =============================
/// FACTURACIÓN
/// =============================

enum EstadoFactura {
  EMITIDA
  ANULADA
}

model Factura {
  id               Int                    @id @default(autoincrement())
  tenantId         Int
  numero           Int
  clienteId        Int
  usuarioId        Int

  subtotal         Decimal                @db.Decimal(12, 2)
  impuesto         Decimal                @db.Decimal(12, 2)
  total            Decimal                @db.Decimal(12, 2)

  estado           EstadoFactura          @default(EMITIDA)
  motivoAnulacion  String?                @db.VarChar(255)

  negocio          Negocio                @relation(fields: [tenantId], references: [id])
  cliente          Cliente                @relation(fields: [clienteId], references: [id])
  usuario          Usuario                @relation(fields: [usuarioId], references: [id])
  detalles         DetalleFactura[]
  movimientos      MovimientoInventario[]

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([clienteId])
  @@index([usuarioId])
  @@map("facturas")
}

model DetalleFactura {
  id             Int      @id @default(autoincrement())
  facturaId      Int
  productoId     Int

  cantidad       Int
  precioUnitario Decimal  @db.Decimal(12, 2)
  subtotalLinea  Decimal  @db.Decimal(12, 2)

  factura        Factura  @relation(fields: [facturaId], references: [id])
  producto       Producto @relation(fields: [productoId], references: [id])

  @@index([facturaId])
  @@index([productoId])
  @@map("detalles_factura")
}